<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Uygulama TEK temali (koyu neon-yesil). Sistem Light modda olsa bile
         beyaz pencere/splash OLMAMALI -> Theme.Black + km_zemin. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Acilis zemini; Flutter ilk kareyi cizince kalkar -->
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:statusBarColor">@color/km_zemin</item>
        <item name="android:navigationBarColor">@color/km_zemin</item>
    </style>

    <!-- Flutter UI cizilirken ve arkasinda gorunen pencere zemini -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/km_zemin</item>
        <item name="android:statusBarColor">@color/km_zemin</item>
        <item name="android:navigationBarColor">@color/km_zemin</item>
    </style>
</resources>
