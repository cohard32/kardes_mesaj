rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
//  KARDEŞ MESAJ — FAZ 4 çok kullanıcılı güvenlik kuralları
//  KURAL: Kimse başkasının mesajını/sohbetini okuyamaz. Arkadaş olmayan
//  iki kişi chat açamaz. Kimse başkası adına yazamaz.
//  ⚠️ Bu kurallar cutover (veri taşıma) ile birlikte deploy edilecek —
//     eski `mesajlar/kullanicilar` uyumu geçiş için korunur.
// ═══════════════════════════════════════════════════════════════════
service cloud.firestore {
  match /databases/{database}/documents {

    function girisli() { return request.auth != null; }
    function benim(uid) { return girisli() && request.auth.uid == uid; }
    function arkadasMi(idPair) {
      return exists(/databases/$(database)/documents/friendships/$(idPair));
    }
    // ⚠️ [arkadasMi] YALNIZCA arkadaşlığın VAR OLDUĞUNA bakar, isteyenin o
    // çiftin ÜYESİ olduğuna DEĞİL. Tek başına kullanılırsa yabancı biri
    // başkalarının verisine erişebilir. Üyelik gerektiren yerlerde bunu kullan.
    function ciftinUyesiyim(idPair) {
      return girisli() && request.auth.uid in
        get(/databases/$(database)/documents/friendships/$(idPair)).data.uidler;
    }
    // Bir çiftteki KARŞI uid (ben olmayan). uidler = [a, b].
    function digerUid(uidler) {
      return uidler[0] == request.auth.uid ? uidler[1] : uidler[0];
    }
    // Karşı taraftan BANA bekleyen bir arkadaşlık isteği var mı?
    // (istek id = {gonderen}_{alan}, alan = ben) → onaysız arkadaşlığı önler.
    function banaIstekVar(uidler) {
      return exists(/databases/$(database)/documents/friend_requests/$(digerUid(uidler) + '_' + request.auth.uid));
    }
    // ENGEL: doküman kimliği ÇİFT KİMLİĞİ ile aynı (sıralı uid'ler) →
    // A'nın B'yi engellemesi ile B'nin A'yı engellemesi AYNI dokümandır.
    // Sonuç: tek `exists` çağrısı iki yönü birden kapatır (ucuz; Spark
    // kotasında her kural okuması sayılır) ve "engellediğim kişi bana yazamaz
    // ama ben ona yazabilirim" gibi tutarsız bir durum oluşamaz.
    // ⚠️ exists() kural motorunda çalışır, okuma iznine BAKMAZ → engellenen
    // taraf dokümanı okuyamasa bile kural onu doğru şekilde engeller.
    function engelli(idPair) {
      return exists(/databases/$(database)/documents/engellenenler/$(idPair));
    }
    function chatKatilimcisi(chatId) {
      return girisli() &&
        request.auth.uid in
          get(/databases/$(database)/documents/chats/$(chatId)).data.katilimcilar;
    }
    // YANIT (alıntı) alanları — üçü de OPSİYONEL (yanıtsız mesajda yok).
    // ⚠️ Tip/uzunluk sunucuda denetlenir: önizleme mesaj dokümanına KOPYA
    // olarak yazıldığı için sınır olmasa biri "önizleme" alanına çok uzun
    // metin koyup karşı tarafın her sohbet açılışında indirmesini sağlardı.
    // İstemci sınırı: yardimcilar/mesaj_metni.dart → yanitOnizlemeSiniri
    // (ikisi birlikte değişmeli). yanitGonderen sohbetin katılımcılarından
    // biri olmalı (sahte "X şunu dedi" alıntısı yazılamasın); aynı chat
    // dokümanı chatKatilimcisi'nde zaten okunuyor (aynı istekte aynı
    // dokümana tekrar erişim ek okuma olarak sayılmaz). `&&` kısa devre
    // yaptığı için yanıtsız mesajda bu get() hiç çalışmaz.
    function yanitAlanlariGecerli(chatId, d) {
      return (!('yanitId' in d) ||
                (d.yanitId is string && d.yanitId.size() > 0 &&
                 d.yanitId.size() <= 128))
        && (!('yanitOnizleme' in d) ||
              (d.yanitOnizleme is string && d.yanitOnizleme.size() <= 120))
        && (!('yanitGonderen' in d) ||
              (d.yanitGonderen is string &&
               d.yanitGonderen in get(/databases/$(database)/documents/chats/$(chatId)).data.katilimcilar));
    }
    // İki uid'den SIRALI çift kimliği — istemcideki `ciftKimligi()` ile aynı.
    // ⚠️ friendships/chats/engellenenler/aramalar dokümanlarının kimliği
    // HER ZAMAN içindeki uid'lerden türetilmiş olmalı. Doğrulanmazsa biri
    // "carol_dave" kimlikli bir dokümanı KENDİ uid'leriyle açıp başkalarının
    // sohbetini işgal edebilir veya aralarına sahte engel koyabilir.
    function ciftId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }
    function ciftKimligiDogru(id, uidler) {
      return uidler is list && uidler.size() == 2 &&
        uidler[0] is string && uidler[1] is string &&
        uidler[0] != uidler[1] &&
        id == ciftId(uidler[0], uidler[1]);
    }
    // usernames/{ad} bu kullanıcıya mı ait? getAfter: kayıt transaction'ı
    // usernames + users dokümanlarını AYNI ANDA yazdığı için yazma SONRASI
    // duruma bakılır.
    function adBenim(uid, ad) {
      return ad is string &&
        getAfter(/databases/$(database)/documents/usernames/$(ad)).data.uid == uid;
    }

    // ---- PROFİLLER ----
    // Herkes okuyabilir (kullanıcı arama/profil görüntüleme).
    // Sadece kişi kendi kaydını oluşturur/günceller. Silme yok.
    // ⚠️ BİLİNEN SINIR (rules testi T6): fcmToken bu dokümanda tutulduğu ve
    //    doküman herkese okunur olduğu için giriş yapmış kullanıcılar
    //    başkasının fcmToken'ını okuyabilir. KARTSIZ mimaride kaçınılmaz:
    //    (a) kullanıcı arama profili public olmalı, (b) arkadaşlık-isteği
    //    push'u henüz-arkadaş-olmayanın token'ını okumayı gerektirir,
    //    (c) FCM gönderme yetkisi zaten APK'daki service_account.json'da.
    //    Token'ı arkadaşa kısıtlamak isteğe-bağlı bildirimi kırar → kabul edildi.
    //
    // ⚠️ @kullanıcı adı SAHTECİLİĞİ: Eskiden `kullaniciAdi` serbestçe
    //    yazılabiliyordu → biri profilinde "@alice" gösterebiliyordu
    //    (usernames/alice başkasına ait olsa bile). Artık profildeki ad
    //    yalnızca usernames/{ad}.uid == kendisi ise yazılabilir ve bir kez
    //    yazıldıktan sonra DEĞİŞMEZ. (Eski hesaplar: alan yoksa/boşsa
    //    profilKur ile ilk kez atanabilir.)
    match /users/{uid} {
      allow read: if girisli();
      allow create: if benim(uid) && (
        !('kullaniciAdi' in request.resource.data) ||
        adBenim(uid, request.resource.data.kullaniciAdi));
      allow update: if benim(uid) && (
        request.resource.data.get('kullaniciAdi', '') ==
          resource.data.get('kullaniciAdi', '') ||
        (resource.data.get('kullaniciAdi', '') == '' &&
          adBenim(uid, request.resource.data.kullaniciAdi)));
      allow delete: if false;
    }

    // ---- KULLANICI ADI BENZERSİZLİĞİ ----
    // Okuma serbest (müsaitlik kontrolü). Oluşturma sadece kendi uid'iyle ve
    // ad daha önce alınmamışsa (transaction bunu garanti eder). Değişmez.
    match /usernames/{ad} {
      // ⚠️ KAYIT ekranında kullanıcı HENÜZ GİRİŞ YAPMAMIŞ olur ama @ad
      // müsaitliğini sorması ŞART → tek doküman GET'i girişsiz serbest.
      // (Doküman yalnız {uid} içerir; users/{uid} okuması yine giriş ister.)
      // Toplu LİSTELEME anonim yapılamaz (enumeration engeli).
      allow get: if true;
      allow list: if girisli();
      allow create: if girisli()
        && request.resource.data.uid == request.auth.uid
        && !exists(/databases/$(database)/documents/usernames/$(ad));
      allow update, delete: if false;
    }

    // ---- ARKADAŞLIK İSTEKLERİ ----
    // Sadece gönderen ve alan görebilir/yönetebilir.
    // resource == null → VAR OLMAYAN doküman: varlık kontrolü (iliskiDurumu)
    // reddedilmesin (yoksa sonsuz loading olur). Var olan isteği yalnız taraflar okur.
    // ⚠️ KİMLİK SAHTECİLİĞİ (yayın sonrası denetim): Eskiden doküman kimliği
    //    doğrulanmıyordu. Mallory `friend_requests/alice_mallory` kimliğiyle
    //    (yani "Alice'ten Mallory'ye" görünen) bir istek AÇIP ardından
    //    friendships'i kendisi kurabiliyordu → Alice'in onayı olmadan arkadaş
    //    olup ona mesaj atabiliyordu. Artık kimlik = {gonderen}_{alan} şart.
    //    Ayrıca engel varken istek gönderilemez (engellenen kişi istek +
    //    bildirim yağdıramasın).
    match /friend_requests/{id} {
      allow read: if girisli() && (
        resource == null ||
        resource.data.gonderenUid == request.auth.uid ||
        resource.data.alanUid == request.auth.uid);
      allow create: if girisli()
        && request.resource.data.gonderenUid == request.auth.uid
        && request.resource.data.alanUid is string
        && request.resource.data.gonderenUid != request.resource.data.alanUid
        && id == request.auth.uid + '_' + request.resource.data.alanUid
        && !engelli(ciftId(request.auth.uid, request.resource.data.alanUid));
      // Güncelleme yalnızca GÖNDEREN için ve taraflar değiştirilemez
      // (uygulama isteği güncellemez; mükerrer set() için açık bırakıldı).
      allow update: if girisli()
        && resource.data.gonderenUid == request.auth.uid
        && request.resource.data.gonderenUid == resource.data.gonderenUid
        && request.resource.data.alanUid == resource.data.alanUid;
      allow delete: if girisli() && (
        resource.data.gonderenUid == request.auth.uid ||
        resource.data.alanUid == request.auth.uid);
    }

    // ---- ARKADAŞLIKLAR ----
    // id = iki uid'den sıralı üretilir (chatId ile AYNI). Sadece taraflar.
    // ⚠️ Oluşturma: karşı taraftan BANA bekleyen istek OLMALI (banaIstekVar) —
    //    yoksa biri kendini onaysız başkasına arkadaş yapabilirdi (rules testi T8).
    match /friendships/{id} {
      // resource == null → var olmayan doküman: arkadasMi varlık kontrolü
      // reddedilmesin (sonsuz loading engeli). Var olanı yalnız taraflar okur.
      allow read: if girisli() &&
        (resource == null || request.auth.uid in resource.data.uidler);
      allow create: if girisli()
        && request.auth.uid in request.resource.data.uidler
        && ciftKimligiDogru(id, request.resource.data.uidler)
        && banaIstekVar(request.resource.data.uidler);
      allow delete: if girisli() && request.auth.uid in resource.data.uidler;
      allow update: if false;
    }

    // ---- SOHBETLER ----
    // chatId = iki uid sıralı (friendshipId ile AYNI).
    // Oluşturma: katılımcı olmalı VE karşı tarafla ARKADAŞ olmalı.
    match /chats/{chatId} {
      // resource == null → var olmayan doküman: sohbetAcOrGetir'in varlık
      // kontrolü (get) reddedilmesin (yoksa "sohbet açılamadı: permission-denied").
      // Var olan sohbeti yalnız katılımcılar okur. Oluşturma yine arkadaşlık ister.
      allow read: if girisli() &&
        (resource == null || request.auth.uid in resource.data.katilimcilar);
      allow create: if girisli()
        && request.auth.uid in request.resource.data.katilimcilar
        && ciftKimligiDogru(chatId, request.resource.data.katilimcilar)
        && arkadasMi(chatId);
      // Katılımcı yalnızca meta alanlarını değiştirebilir. ⚠️ Eskiden her alan
      // serbestti → bir taraf `katilimcilar`ı değiştirip karşı tarafı kendi
      // sohbetinden ATABİLİYOR ya da üçüncü birini EKLEYEBİLİYORDU.
      allow update: if girisli()
        && request.auth.uid in resource.data.katilimcilar
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'sonMesaj', 'sonMesajZamani', 'sonMesajGonderen',
             'okunmamis', 'yaziyor']);
      allow delete: if false;

      // ---- MESAJLAR ----
      // Okuma: katılımcılar (eski geçmiş arkadaşlık bitse de görünür).
      // Yazma: katılımcı OLMAK + hâlâ ARKADAŞ olmak + kendi adına
      //   (arkadaşlıktan çıkınca yeni mesaj/arama gönderilemesin — chatId=friendshipId).
      // Güncelleme: sadece goruldu/tepki/sesDinlendi alanları değişebilir
      //   (biri diğerinin mesaj metnini/göndericisini bozamasın — yanıt
      //   alanları da bu yüzden oluşturulduktan sonra DEĞİŞMEZ).
      match /messages/{msgId} {
        allow read: if chatKatilimcisi(chatId);
        // `zaman == request.time`: istemci FieldValue.serverTimestamp() yazar,
        // sunucu bunu commit anına çözer → eşitlik sağlanır. ⚠️ Bu kontrol
        // olmadan biri `zaman`ı 2100 yılına yazıp aşağıdaki "60 sn içinde
        // silme" kuralını sonsuza kadar uzatabiliyordu (emülatörde doğrulandı).
        allow create: if chatKatilimcisi(chatId)
          && arkadasMi(chatId)
          && !engelli(chatId)
          && request.resource.data.gonderen == request.auth.uid
          && request.resource.data.zaman == request.time
          && request.resource.data.keys().hasOnly([
               'gonderen', 'metin', 'tip', 'medyaUrl', 'zaman', 'goruldu',
               'yanitId', 'yanitOnizleme', 'yanitGonderen'])
          && yanitAlanlariGecerli(chatId, request.resource.data);
        allow update: if chatKatilimcisi(chatId)
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['goruldu', 'tepki', 'sesDinlendi']);
        // SİLME: yalnızca KENDİ mesajını ve yalnızca ilk 60 SANİYE içinde.
        // ⚠️ Süre SUNUCUDA doğrulanır — istemcideki gizleme yeterli değildir
        // (uygulama değiştirilip eski mesaj silinmeye çalışılabilir).
        // `request.time` sunucu zamanı, `zaman` mesajın serverTimestamp'ı.
        allow delete: if chatKatilimcisi(chatId)
          && resource.data.gonderen == request.auth.uid
          && resource.data.zaman is timestamp
          && request.time < resource.data.zaman + duration.value(60, 's');
      }
    }

    // ---- ARAMA SİNYALLEŞMESİ ----
    // aramalar/{chatId} — sadece o çiftin arkadaşları.
    // ⚠️ GÜVENLİK: Eskiden `arkadasMi(chatId)` idi — o yalnız arkadaşlığın VAR
    // olduğuna bakıyordu, isteyenin ÜYE olduğuna değil. Sonuç: giriş yapmış
    // HERHANGİ biri başkalarının arama dokümanını okuyup Agora KANAL ADINI
    // alabiliyor (→ aramaya katılıp dinleyebilir) veya durum='bitti' yazıp
    // aramalarını düşürebiliyordu. Artık sadece o çiftin ÜYELERİ erişebilir.
    match /aramalar/{chatId} {
      // Okuma engelliyken de serbest: devam eden bir aramanın 'bitti' durumunu
      // iki taraf da GÖREBİLMELİ (engel tam o sırada konursa arama ekranı
      // sonsuza kadar 'Bağlanıyor…'da kalmasın). YENİ arama başlatmak =
      // yazmak → engelliyken reddedilir.
      allow read: if ciftinUyesiyim(chatId);
      allow write: if ciftinUyesiyim(chatId) && !engelli(chatId);
    }

    // ---- ENGELLEME ----
    // id = ciftKimligi(a, b) — friendships/chats ile AYNI kimlik.
    // Alanlar: {uidler:[a,b], engelleyen: uid, zaman}
    // ⚠️ Engeli yalnızca KOYAN kaldırabilir; engellenen kişi kendi üzerindeki
    // engeli silemez (silebilseydi engelleme hiçbir şey ifade etmezdi).
    match /engellenenler/{id} {
      // resource == null → var olmayan doküman: "engelli miyim" kontrolü
      // reddedilmesin (yoksa sohbet ekranı sonsuz yüklenir).
      allow read: if girisli() &&
        (resource == null || request.auth.uid in resource.data.uidler);
      // ⚠️ Kimlik uid'lerden türetilmeli: eskiden doğrulanmıyordu ve HERHANGİ
      // biri `engellenenler/alice_bob` dokümanını kendi uid'iyle açıp Alice
      // ile Bob'un birbirine yazmasını KALICI olarak engelleyebiliyordu
      // (ikisi de dokümanı okuyamaz/silemez → teşhisi bile imkânsız).
      allow create: if girisli()
        && request.auth.uid in request.resource.data.uidler
        && ciftKimligiDogru(id, request.resource.data.uidler)
        && request.resource.data.engelleyen == request.auth.uid;
      allow delete: if girisli() && resource.data.engelleyen == request.auth.uid;
      allow update: if false;
    }

    // ---- NATIVE ÇÖKME ADLİ TIBBI ----
    // Kişi başına TEK doküman; riskli adımdan önce üzerine yazılır.
    // Native çökmede süreç ölür ama bu kayıt sunucuda kalır → son adım görülür.
    match /son_adim/{uid} {
      allow write: if benim(uid);
      allow read: if false; // yalnız admin SDK okur
    }

    // ---- UZAKTAN TEŞHİS (hata/iz raporları) ----
    // Kullanıcı yalnız KENDİ raporunu OLUŞTURABİLİR. İstemci OKUYAMAZ
    // (raporlar cihaz/uid bilgisi içerir); okuma yalnız admin SDK ile yapılır.
    match /hatalar/{id} {
      allow create: if girisli() && request.resource.data.uid == request.auth.uid;
      allow read, update, delete: if false;
    }

    // ═══ ESKİ (FAZ 4 ÖNCESİ) KOLEKSİYONLAR — KİLİTLİ ═══
    //
    // ⚠️ Eskiden ikisi de `allow read, write: if girisli()` idi → giriş yapmış
    // HERHANGİ bir kullanıcı 326 eski mesajın TAMAMINI okuyabiliyor/silebiliyor
    // ve HERKESİN fcmToken'ını değiştirebiliyordu. (Yayın öncesi denetimde
    // bulundu.) Veri SİLİNMEDİ, yalnızca erişim kapatıldı.

    // Eski mesaj geçmişi: uygulama bu koleksiyonu HİÇ kullanmıyor (doğrulandı).
    // Tamamen kapalı. İleride taşınacaksa admin SDK kuralları atlar.
    match /mesajlar/{id} {
      allow read, write: if false;
    }

    // Eski kullanıcı dokümanı: kod yalnızca KENDİ dokümanına yazar
    // (tokenKaydet / kanalYayinla / sonCagriPush teşhisi) → kendi uid'i yeter.
    match /kullanicilar/{uid} {
      allow read, write: if benim(uid);
    }
  }
}
